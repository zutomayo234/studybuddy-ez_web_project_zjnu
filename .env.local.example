# =====================================================================
#  本地环境变量模板
#  用法：复制本文件为 .env.local，再把下面的占位值换成你自己的真实值。
#      Windows Git Bash :  cp .env.local.example .env.local
#      Windows CMD      :  copy .env.local.example .env.local
#
#  为什么单独放一个文件？
#    .env.local 已被 .gitignore 忽略，真实密码与密钥不会进入仓库和压缩包；
#    而本模板（.env.local.example）不含任何真实凭据，可以安全提交。
# =====================================================================

# ---------- 必需：MySQL 密码 ----------
# 对应 application.yml 里的 ${DB_PASSWORD:}
DB_PASSWORD=你的MySQL密码

# ---------- 可选：大模型 API Key ----------
# 不配置也能启动，智能问答会自动降级为“知识库直答”，仍可演示 RAG。
# 配置后走真实模型。对应 ${LLM_API_KEY:}
LLM_API_KEY=你的DeepSeek密钥

# ---------- 可选：切换大模型服务商 ----------
# 改 base-url 与 model 时必须与 Key 属于同一家服务商，否则会报 invalid_api_key。
# DeepSeek 官方（默认）：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# 阿里云百炼：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-turbo
